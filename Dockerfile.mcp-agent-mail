# Upstream has not published a current wheel. Pin the source revision used by
# Gas City's own Kubernetes contribution rather than tracking its main branch.
FROM python:3.12-slim
ARG MCP_AGENT_MAIL_REF=32783f6848bd63c425c4b5004cee3350016635fb
ENV PYTHONDONTWRITEBYTECODE=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir "mcp-agent-mail @ https://github.com/Dicklesworthstone/mcp_agent_mail/archive/${MCP_AGENT_MAIL_REF}.tar.gz" \
    && useradd -r -m -d /var/lib/mcp-mail -s /usr/sbin/nologin mcp-mail
USER mcp-mail
WORKDIR /var/lib/mcp-mail
EXPOSE 8765
ENTRYPOINT ["python3", "-m", "mcp_agent_mail.http", "--host", "0.0.0.0", "--port", "8765"]
