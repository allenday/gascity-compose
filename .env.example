# Copy to .env. All host paths must be absolute when running on Linux.
CITY_DIR=/Users/gastown/my-city
MY_PROJECT_DIR=/Users/gastown/my-project
GASCITY_SOURCE_DIR=/Users/gastown/src/gascity
CODEX_AUTH_FILE=/Users/gastown/.codex/auth.json
CITY_NAME=my-city
# Match the source revision used by the host City before handoff.
GASCITY_REF=ab54f93c3b3d30bb8f52f7e92c0761fb75340752
CAGENT_REF=v1.23.0

# The existing fixture can be adopted by setting this to its state directory:
# GITEA_STATE_DIR=/Users/gastown/src/gascity-gitea-contrib/test/gitea/state
GITEA_STATE_DIR=./state/gitea
GITEA_HTTP_PORT=3002
GITEA_SSH_PORT=2223

GRAFANA_PORT=3000
GATUS_PORT=8080
PROMETHEUS_PORT=9090
LOKI_PORT=3100
OLLAMA_PORT=11435
GASCITY_MCP_DIR=../gascity-mcp
GASCITY_MCP_PORT=8766

# Official Gitea MCP is profile-gated: docker compose --profile gitea-mcp up -d.
# Use a distinct non-admin Gitea service-account token for each permission
# class. Do not reuse an admin token. Scope each token no wider than needed.
GITEA_MCP_MAYOR_PORT=8771
GITEA_MCP_OBSERVER_PORT=8772
GITEA_MCP_WITNESS_PORT=8773
GITEA_MAYOR_TOKEN=
GITEA_OBSERVER_TOKEN=
GITEA_WITNESS_TOKEN=

# Pulling a model is deliberately a separate profile: docker compose --profile models up model-init
OLLAMA_MODEL=gemma4:12b-it-qat
DOLT_USER_NAME=Allen Day
DOLT_USER_EMAIL=allenday@allenday.com
# Set to `id -u` and `id -g` on the Docker host before first City start.
HOST_UID=1000
HOST_GID=1000
GRAFANA_ADMIN_PASSWORD=change-me-before-exposing
