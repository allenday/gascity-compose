# Copy to .env. All host paths must be absolute when running on Linux.
TAILNET_IP=100.64.0.1
STACK_USERNAME=admin
STACK_PASSWORD=change-me-before-exposing
CITY_DIR=/Users/gastown/my-city
MY_PROJECT_DIR=/Users/gastown/my-project
GASCITY_SOURCE_DIR=/Users/gastown/src/gascity
CODEX_AUTH_FILE=/Users/gastown/.codex/auth.json
CITY_NAME=my-city
# Match the source revision used by the host City before handoff.
GASCITY_REF=ab54f93c3b3d30bb8f52f7e92c0761fb75340752
CAGENT_REF=v1.23.0

# The existing fixture can be adopted by setting this to its state directory:
# GITEA_STATE_DIR=/Users/gastown/src/gascity-gitea-contrib/test/gitea/state
GITEA_STATE_DIR=./state/gitea
GITEA_HTTP_PORT=3002
GITEA_SSH_PORT=2223

GRAFANA_PORT=3000
GATUS_PORT=8080
PROMETHEUS_PORT=9090
LOKI_PORT=3100
OLLAMA_PORT=11435
OLLAMA_METRICS_DIR=../ollama-metrics
# Optional development override. When omitted, Compose builds the immutable
# gascity-mcp Git revision declared in compose.yaml.
# GASCITY_MCP_DIR=/Users/gastown/src/gascity-mcp
GASCITY_MCP_PORT=8766

# Official Gitea MCP is profile-gated: docker compose --profile gitea-mcp up -d.
# Use a distinct non-admin Gitea service-account token for each permission
# class. Do not reuse an admin token. Scope each token no wider than needed.
GITEA_MCP_MAYOR_PORT=8771
GITEA_MCP_OBSERVER_PORT=8772
GITEA_MCP_WITNESS_PORT=8773
GITEA_MAYOR_TOKEN=
GITEA_OBSERVER_TOKEN=
GITEA_WITNESS_TOKEN=

# Optional single-binding, status-only delivery bridge. Use a dedicated
# restricted Gitea account/token with issue read/write scope.
GITEA_BRIDGE_DIR=../gascity-gitea
GASCITY_GITEA_REF=06f2fb4d5faec5c0a99e7ab3eb2dff183ef6faed
GITEA_BRIDGE_TOKEN=
# Use Gitea's internal URL because the bridge validates it against GITEA_URL.
GITEA_BRIDGE_ISSUE_URL=
GITEA_BRIDGE_RUN_ID=
GITEA_BRIDGE_INTERVAL_SECONDS=30

# Woodpecker is opt-in: docker compose --profile woodpecker up -d.
# Run `make woodpecker-fixture-bootstrap ENV_FILE=.env` once against a fresh
# local Gitea. It creates this private fixture repository and fills the OAuth
# values below; use `openssl rand -hex 32` for the agent secret.
WOODPECKER_STATE_DIR=./state/woodpecker
WOODPECKER_PORT=8000
WOODPECKER_HOST=http://127.0.0.1:8000
# Browser-facing Gitea URL used only for OAuth redirects. Keep the Docker
# service URL private to the Compose network.
WOODPECKER_GITEA_BROWSER_URL=
WOODPECKER_ADMIN=woodpecker-fixture
WOODPECKER_REPO_OWNERS=woodpecker-fixture
WOODPECKER_PIPELINE_TIMEOUT=15
WOODPECKER_AGENT_SECRET=
WOODPECKER_GITEA_CLIENT=
WOODPECKER_GITEA_SECRET=
GITEA_WOODPECKER_TOKEN=
GITEA_WOODPECKER_PASSWORD=
# Generated by the fixture bootstrap. It is scoped only to publishing the
# fixture's retained generic-package artifact.
GITEA_WOODPECKER_PACKAGE_TOKEN=
WOODPECKER_FIXTURE_REPOSITORY=gascity-compose-fixture

# Pulling a model is deliberately a separate profile: docker compose --profile models up model-init
OLLAMA_MODEL=gemma4:12b-it-qat
# Gas City inference profiles. These values are non-secret; Compose renders
# them into Codex TOML under the City container's ephemeral CODEX_HOME.
GEMMA_MODEL=gemma4:12b-it-qat
TAILNET_OLLAMA_BASE_URL=http://100.64.0.1:11435/v1
RUNPOD_OPENAI_BASE_URL=https://api.runpod.ai/v2/your-endpoint-id/openai/v1
# RUNPOD_API_KEY is intentionally supplied from the host environment rather
# than stored here. The city config references it as $RUNPOD_API_KEY.

# Opinionated build methodology. Defaults are shown for discoverability;
# omit them to use the same values built into Compose.
SUPERPOWERS_PACK_ENABLED=true
SUPERPOWERS_PACK_SOURCE=https://github.com/gastownhall/gascity-packs/tree/main/superpowers
SUPERPOWERS_PACK_VERSION=sha:3b3b89f2011e06d84459aa7bea1552382f13930a
DOLT_USER_NAME=Allen Day
DOLT_USER_EMAIL=allenday@allenday.com
# Set to `id -u` and `id -g` on the Docker host before first City start.
HOST_UID=1000
HOST_GID=1000
# Defaults to STACK_USERNAME / STACK_PASSWORD when omitted.
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=change-me-before-exposing
